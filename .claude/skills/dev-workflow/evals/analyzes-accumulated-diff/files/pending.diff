commit 2222222bbbbbbb
    fix: paginate the client

    Closes #40

diff --git a/api/client.py b/api/client.py
--- a/api/client.py
+++ b/api/client.py
@@ -1,6 +1,9 @@
 class Client:
-    def fetch(self):
-        """Return every record."""
-        return self._get("/records")
+    def fetch(self, page_size):
+        """Return one page of records. page_size is required."""
+        return self._get("/records", params={"limit": page_size})
+
+    def fetch_all(self):
+        """Iterate over every record, page by page."""
+        yield from self._paged("/records")
