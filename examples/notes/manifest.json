{
  "manifest_version": 1,
  "kind": "app",
  "app_id": "org.skeleton.example-notes",
  "app_label": "example_notes",
  "package_name": "notes",
  "app_config": "applications.notes.apps.NotesConfig",
  "name": "Anotações",
  "description": "Anotações de demonstração do contrato de extensão",
  "version": "0.1.0",
  "publisher": "skeleton-examples",
  "compatibility": {"skeleton": ">=0.1.0,<1.0.0", "python": ">=3.12,<3.15", "django": ">=5.2,<5.3"},
  "dependencies": {},
  "conflicts": {},
  "runtime": {
    "urls": "applications.notes.urls",
