{
  "manifest_version": 2,
  "kind": "app",
  "app_id": "org.skeleton.example-notes",
  "app_label": "example_notes",
  "package_name": "notes",
  "app_config": "applications.notes.apps.NotesConfig",
  "name": "Anotações",
  "description": "Anotações de demonstração do contrato de extensão",
  "version": "0.2.0",
  "publisher": "skeleton-examples",
  "compatibility": {"skeleton": ">=0.3.0,<1.0.0", "python": ">=3.12,<3.15", "django": ">=5.2,<5.3"},
  "dependencies": {},
  "conflicts": {},
  "runtime": {
    "urls": "applications.notes.urls",
    "api_urls": "applications.notes.api_urls",
    "default_enabled": true,
    "configuration_fields": [{"name": "heading", "type": "str", "default": "Anotações", "max_length": 200, "label": "Título da aplicação", "help_text": "Título exibido na página de anotações desta organização.", "section_id": "general"}],
    "navigation": [{"label": "Anotações", "url_name": "example_notes:home", "table_key": "example_notes.note", "action": "read"}],
    "documentation_root": "docs",
    "administration": {
      "configuration_sections": [{"id": "general", "label": "Geral", "order": 10}],
      "sections": [{"id": "parameters", "label": "Parâmetros", "order": 20}],
      "screens": [{"id": "configuration", "section_id": "parameters", "label": "Configuração de anotações", "order": 10, "scope": "organization", "kind": "configuration", "organization_admin_only": true}]
    },
    "model_ui": [{
      "table_key": "example_notes.note",
      "list": {"columns": ["code", "title", "updated_at"], "filters": ["code"], "title_field": "title"},
      "form": {
        "tabs": [{"id": "general", "label": "Identificação"}, {"id": "content", "label": "Conteúdo"}],
        "sections": [
          {"id": "identification", "label": "Identificação", "tab_id": "general", "columns": 2, "fields": [{"name": "code", "label": "Código", "col_span": 4}, {"name": "title", "label": "Título", "col_span": 8}]},
          {"id": "content", "label": "Conteúdo", "tab_id": "content", "fields": [{"name": "body", "label": "Texto", "help_text": "Conteúdo da anotação.", "widget": "textarea", "col_span": 12, "rows": 8}]}
        ]
      }
    }]
  },
  "migrations": {"leaves": ["0001_initial"], "from_versions": ">=0.0.0", "labels": ["example_notes"]},
  "files": [],
  "python_dependencies": [],
  "lifecycle": {"data_retention": "retain", "maintenance": true, "backup": true},
  "release_notes": "Primeiro release do exemplo opt-in; dados preservados na retirada do código."
}
