# Variables of ONE instance on the data server (#679): copy to /srv/data/<instance>.env (0600, never
# versioned) and fill. Generate every password with `openssl rand -hex 32` (letters and digits only:
# they go into URLs unencoded).
#
# docker compose -p <instance> --env-file /srv/data/<instance>.env -f deploy/data-server/compose.yaml up -d

# Private address of the data server that the application nodes reach.
DATA_BIND_ADDRESS=
# The network of the application nodes (CIDR), the only one pg_hba accepts.
DATA_CLIENT_CIDR=
# Directory with server.crt and server.key of the data server (TLS is required).
DATA_TLS_DIR=

# Ports of this instance; each instance on the server takes its own.
POSTGRES_PORT=
REDIS_PORT=
# Only with the "pooler" profile.
PGBOUNCER_PORT=

POSTGRES_PASSWORD=
SKELETON_OWNER_DB_PASSWORD=
SKELETON_RUNTIME_DB_PASSWORD=
# Only when the instance has follower nodes (#678).
SKELETON_AGENT_DB_PASSWORD=
REDIS_PASSWORD=
# Optional: REDIS_MAXMEMORY (default 256mb), POSTGRES_DB (default skeleton).
