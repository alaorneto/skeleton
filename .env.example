# A fresh instance needs nothing here: the first-access setup (/setup/) writes the instance
# configuration (#146). These bootstrap variables only locate it (#143).
DJANGO_SETTINGS_MODULE=config.settings.development
SKELETON_ENABLE_EXAMPLE_APP=false
# SKELETON_INSTANCE_DB=var/instance/instance.sqlite3
# SKELETON_INSTANCE_KEY_FILE=var/instance/master.key
# SKELETON_SETUP=off  # disable the setup switch (configuration entirely from the environment)
# Owner credential for migrations: transient, never stored in the instance SQLite.
# MIGRATION_DATABASE_URL=postgres://skeleton_owner:password@localhost:5432/skeleton

# Everything below lives in the instance SQLite (`manage.py instance set|show`, secrets
# encrypted). Uncomment a line only to override the stored value: the environment wins.
# `manage.py instance import-env` copies the current environment into the SQLite.
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional healthcheck Host (default: the first DJANGO_ALLOWED_HOSTS entry); must be allowed.
# DJANGO_HEALTH_HOST=localhost
# DJANGO_TRUST_PROXY=false
# DJANGO_TRUSTED_PROXY_COUNT=0
# DJANGO_TRUSTED_CLIENT_IP_HEADER=X-Real-IP
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.org
# SKELETON_JSON_MAX_BYTES=1048576
# SKELETON_PUBLIC_SIGNUP=false
# SKELETON_REQUIRE_ADMIN_MFA=false
# DATABASE_URL=postgres://skeleton_runtime:password@localhost:5432/skeleton  # PostgreSQL only
# CACHE_URL=rediscache://127.0.0.1:6379/1
# EMAIL_URL=smtp+tls://user:password@mail.example:587
# DEFAULT_FROM_EMAIL=app@example.org
# MFA_ENCRYPTION_KEYS=key-new,key-old
# IDENTITY_PROVIDER_ENCRYPTION_KEYS=key-new,key-old
# INTEGRATION_ENCRYPTION_KEYS=key-new,key-old
# SSO_PROVIDER_CONFIG_PATH=/private/providers.json
