DJANGO_SETTINGS_MODULE=config.settings.development
# Generate a private random secret before deploying.
# DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Compose health Host must be included in DJANGO_ALLOWED_HOSTS.
DJANGO_HEALTH_HOST=localhost
DJANGO_TRUST_PROXY=false
DJANGO_TRUSTED_PROXY_COUNT=0
# DJANGO_TRUSTED_CLIENT_IP_HEADER=X-Real-IP
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.org
SKELETON_JSON_MAX_BYTES=1048576
SKELETON_PUBLIC_SIGNUP=false
SKELETON_ENABLE_EXAMPLE_APP=false
SKELETON_REQUIRE_ADMIN_MFA=false
# DATABASE_URL=postgres://skeleton_runtime:password@localhost:5432/skeleton
# MIGRATION_DATABASE_URL=postgres://skeleton_owner:password@localhost:5432/skeleton
# CACHE_URL=rediscache://127.0.0.1:6379/1
# EMAIL_URL=smtp+tls://user:password@mail.example:587
# DEFAULT_FROM_EMAIL=app@example.org
# MFA_ENCRYPTION_KEYS=key-new,key-old
# SSO_PROVIDER_CONFIG_PATH=/private/providers.json
