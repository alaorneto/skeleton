{% extends 'skeleton/web/base.html' %}
{% block content %}
<h1>{{ heading }}</h1>
<p>Registros legíveis: {{ count }}</p>
<a href="{% url 'web:records' organization_id '${table_key}' %}">Abrir registros</a>
{% if can_manage_applications %}<p><a href="{% url 'application-configuration' organization_id '${app_label}' %}">Administrar esta app</a></p>{% endif %}
{% endblock %}
