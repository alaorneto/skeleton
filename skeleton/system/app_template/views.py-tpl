from django.shortcuts import render
from rest_framework.response import Response

from skeleton.api.views import TenantAPI
from skeleton.web.views import tenant_page

from .service_api import ${service_class}


@tenant_page()
def home(request, organization_id):
    count = ${service_class}().${model_lower}_count(actor=request.user)
    return render(
        request,
        "${app_label}/home.html",
        {"heading": "${verbose_name}", "count": count, "organization_id": organization_id},
    )


class SummaryView(TenantAPI):
    def get(self, request, organization_id):
        return Response({"count": ${service_class}().${model_lower}_count(actor=request.user)})
